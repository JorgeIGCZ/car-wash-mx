APP_ENV="local"
NEXT_PUBLIC_APP_ENV="local"

DATABASE_URL="mysql://turbo:turbo@localhost:3306/turbo_wash"
SESSION_COOKIE_NAME="turbo_wash_session"
TZ="America/Mexico_City"
INITIAL_ADMIN_NAME="Administrador"
INITIAL_ADMIN_EMAIL="admin@turbowash.mx"
INITIAL_ADMIN_PASSWORD="CAMBIA_ESTA_CONTRASENA"
# Opcional: crea el primer encargado desde el seed.
INITIAL_EMPLOYEE_NAME="Encargado"
INITIAL_EMPLOYEE_EMAIL="encargado@turbowash.mx"
INITIAL_EMPLOYEE_PASSWORD="CAMBIA_ESTA_CONTRASENA"

# Cloudflare R2 (bucket privado)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="turbo-wash-photos"

# Evidencia: habilitar despues de configurar CORS, lifecycle y limpieza.
EVIDENCE_ENABLED="false"
# Secreto aleatorio de al menos 32 caracteres para la limpieza programada.
EVIDENCE_CLEANUP_SECRET=""
