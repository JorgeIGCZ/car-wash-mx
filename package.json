{
  "name": "turbo-wash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "TZ=America/Mexico_City next dev",
    "build": "prisma migrate deploy && prisma generate && TZ=America/Mexico_City next build",
    "start": "TZ=America/Mexico_City next start",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:production": "node --env-file=.env.production node_modules/prisma/build/index.js migrate deploy",
    "db:status:production": "node --env-file=.env.production node_modules/prisma/build/index.js migrate status",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.525.0",
    "next": "^15.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.5",
    "postcss": "^8.5.16",
    "prisma": "^6.11.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
