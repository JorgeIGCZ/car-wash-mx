generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ADMINISTRATIVE
  EMPLOYEE
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum ServiceCategory {
  NORMAL
  INTERIOR
  SPECIAL
}

model User {
  id                     Int               @id @default(autoincrement())
  name                   String
  email                  String            @unique
  passwordHash           String
  mustChangePassword     Boolean           @default(true)
  passwordChangedAt      DateTime?
  role                   UserRole          @default(EMPLOYEE)
  isPartner              Boolean           @default(false)
  partnerSharePercentage Decimal?          @db.Decimal(5, 2)
  active                 Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  sessions               Session[]
  washesCreated          Wash[]            @relation("CreatedWashes")
  washesDeleted          Wash[]            @relation("DeletedWashes")
  washParticipations     WashParticipant[]
  commissionRules        CommissionRule[]
  washCommissions        WashCommission[]
  expensesCreated        Expense[]         @relation("CreatedExpenses")
  expenseReimbursements  Expense[]         @relation("ExpensePartner")
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VehicleType {
  id              Int              @id @default(autoincrement())
  name            String
  slug            String           @unique
  requiresCustom  Boolean          @default(false)
  active          Boolean          @default(true)
  sortOrder       Int              @default(0)
  prices          ServicePrice[]
  washes          Wash[]
  commissionRules CommissionRule[]
}

model ServicePackage {
  id                  Int              @id @default(autoincrement())
  name                String
  slug                String           @unique
  description         String?
  category            ServiceCategory
  requiresCustomPrice Boolean          @default(false)
  requiresDescription Boolean          @default(false)
  active              Boolean          @default(true)
  sortOrder           Int              @default(0)
  prices              ServicePrice[]
  washes              Wash[]
  commissionRules     CommissionRule[]
}

model ServicePrice {
  id            Int            @id @default(autoincrement())
  amount        Decimal        @db.Decimal(10, 2)
  vehicleTypeId Int
  packageId     Int
  vehicleType   VehicleType    @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  package       ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([vehicleTypeId, packageId])
}

model Wash {
  id                       Int               @id @default(autoincrement())
  plate                    String?           @db.VarChar(32)
  chargedPrice             Decimal           @db.Decimal(10, 2)
  notes                    String?           @db.Text
  customServiceDescription String?           @db.Text
  deletedAt                DateTime?
  deletedById              Int?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  createdById              Int
  vehicleTypeId            Int
  packageId                Int
  createdBy                User              @relation("CreatedWashes", fields: [createdById], references: [id])
  vehicleType              VehicleType       @relation(fields: [vehicleTypeId], references: [id])
  package                  ServicePackage    @relation(fields: [packageId], references: [id])
  deletedBy                User?             @relation("DeletedWashes", fields: [deletedById], references: [id], onDelete: Restrict)
  participants             WashParticipant[]
  commissions              WashCommission[]
  photos                   WashPhoto[]

  @@index([createdById, createdAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([deletedById])
}

model WashPhoto {
  id        Int      @id @default(autoincrement())
  objectKey String   @unique @db.VarChar(512)
  mimeType  String   @db.VarChar(100)
  byteSize  Int
  width     Int
  height    Int
  createdAt DateTime @default(now())
  washId    Int
  wash      Wash     @relation(fields: [washId], references: [id], onDelete: Cascade)

  @@index([washId, createdAt])
}

model WashParticipant {
  washId Int
  userId Int
  wash   Wash @relation(fields: [washId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([washId, userId])
}

model CommissionRule {
  id            Int              @id @default(autoincrement())
  scopeKey      String           @db.VarChar(100)
  type          CommissionType
  value         Decimal          @db.Decimal(10, 2)
  category      ServiceCategory?
  userId        Int
  vehicleTypeId Int?
  packageId     Int?
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType   VehicleType?     @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  package       ServicePackage?  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeKey])
  @@index([packageId, vehicleTypeId])
}

model WashCommission {
  washId Int
  userId Int
  type   CommissionType
  value  Decimal        @db.Decimal(10, 2)
  amount Decimal        @db.Decimal(10, 2)
  wash   Wash           @relation(fields: [washId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([washId, userId])
  @@index([userId])
}

model Expense {
  id            Int      @id @default(autoincrement())
  expenseDate   DateTime
  concept       String   @db.VarChar(160)
  amount        Decimal  @db.Decimal(10, 2)
  notes         String?  @db.Text
  takenFromCash Boolean  @default(false)
  reimbursable  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  partnerId     Int?
  createdById   Int
  partner       User?    @relation("ExpensePartner", fields: [partnerId], references: [id], onDelete: Restrict)
  createdBy     User     @relation("CreatedExpenses", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([expenseDate])
  @@index([partnerId, expenseDate])
  @@index([createdById])
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.VarChar(255)
  updatedAt DateTime @updatedAt
}
